# Doxly backend — environment variables (specs/devops.md §2, §7).
# Copy to .env for local development. Never commit a real .env file.

ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://doxly:doxly@localhost:5432/doxly

# --- R1 (tasks/remediation-plan.md) — auth, CSRF, rate limiting ---
JWT_SIGNING_KEY=change-me-to-a-real-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# decisions.md OQ-01 — leave unset to disable Google OAuth (the /auth/oauth/*
# endpoints return oauth_not_configured rather than failing unpredictably).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FRONTEND_BASE_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

# decisions.md ADR-020 — "fake" (logs to memory, zero-cost) until SMTP
# settings are supplied.
EMAIL_PROVIDER=fake
EMAIL_FROM_ADDRESS=no-reply@doxly.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- R2 (tasks/remediation-plan.md) — document storage ---
# decisions.md ADR-022 — "local" (a real filesystem-backed implementation)
# until real cloud storage credentials are supplied.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.local-storage
STORAGE_PRESIGNED_URL_EXPIRES_IN_SECONDS=900
# FastAPI's own externally-reachable origin — only used to construct
# LocalFilesystemStorageProvider's presigned URLs (never the same as
# FRONTEND_BASE_URL — see core/config.py's own note on why).
BACKEND_PUBLIC_BASE_URL=http://localhost:8000
# deployment.md §5.1 — only meaningful once STORAGE_PROVIDER points at a
# real cloud provider (e.g. "blob"/"s3"/"r2"); unused while "local".
STORAGE_ACCESS_TOKEN=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- decisions.md ADR-011/ADR-012 — AI providers ---
# "fake" (deterministic, offline, zero-cost) until a real key is supplied
# — the default every test and local dev run in this codebase uses.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=fake
OPENAI_API_KEY=

# --- R3 (tasks/remediation-plan.md) — worker crash recovery ---
DOCUMENT_PROCESSING_STALE_THRESHOLD_SECONDS=900

# --- R12 (tasks/remediation-plan.md) — production deployment readiness ---
# deployment.md §5.1/§11 — comma-separated allow-list, no wildcards in
# production; the local Next.js dev origin by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# deployment.md §5.1/§10 — debug locally, info/warning in production.
LOG_LEVEL=debug
