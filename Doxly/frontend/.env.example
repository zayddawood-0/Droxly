# Doxly frontend — environment variables (specs/deployment.md §5.1).
# Copy to .env.local for development. Never commit a real .env file.

# Server-only (unprefixed) — the origin the Next.js Route Handler BFF
# (app/api/v1/[...path]/route.ts) calls server-side. Not sent to the browser.
INTERNAL_API_URL=http://localhost:8000

# R12 correction: every request, including the chat SSE stream, is proxied
# same-origin through app/api/v1/[...path]/route.ts (lib/api/chat.ts never
# calls the backend origin directly; presigned upload URLs the browser does
# PUT directly against arrive as full URLs in the API response body, not via
# this variable). NEXT_PUBLIC_API_BASE_URL has no reader anywhere in this
# codebase today -- left commented out rather than deleted, since
# specs/deployment.md §5.1 still reserves the name. Do not set this expecting
# it to change any request's destination; nothing consumes it.
# NEXT_PUBLIC_API_BASE_URL=
